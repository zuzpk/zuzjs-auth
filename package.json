{
  "name": "@zuzjs/auth",
  "version": "0.1.10",
  "keywords": [
    "core",
    "zuz",
    "zuz.js",
    "zuz flare",
    "zuz development tool kit",
    "zuzjs"
  ],
  "description": "Browser-focused OAuth 2.0 and PKCE helpers for the @zuzjs ecosystem",
  "author": "Zuz.js Team <support@zuz.com.pk>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:js": "tsup --watch",
    "dev": "npm-run-all -p dev:*",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsup",
    "test": "npm run build && node --test test/*.test.mjs",
    "publish": "npm run build && node publish-pre.js && npm publish && node publish-post.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "sideEffects": [
    "reflect-metadata"
  ],
  "devDependencies": {
    "@types/node": "^25.3.0",
    "husky": "^9.1.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}